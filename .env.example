# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Configure this via the Secrets panel in AI Studio or in your local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="MY_APP_URL"

# Optional PostgreSQL / Cloud SQL settings for cloud-synced workspaces
SQL_HOST="MY_SQL_HOST"
SQL_DB_NAME="MY_SQL_DB_NAME"
SQL_USER="MY_SQL_USER"
SQL_PASSWORD="MY_SQL_PASSWORD"
